  <!-- 매 빌드 현재 원본을 수집한다. 프로젝트 표시 목록과 복사 대상은 별개다. -->
  <Target Name="SESyncContent" AfterTargets="Build">
    <Error Condition="'$(OutDir)' == '' Or '$(SERootDir)' == ''" Text="콘텐츠 동기화에는 OutDir와 SERootDir가 필요하다." />
    <PropertyGroup>
      <_SEContentRoot>$([System.IO.Path]::GetFullPath('$(OutDir)Content\'))</_SEContentRoot>
      <_SEEngineContentRoot>$(_SEContentRoot)Engine\</_SEEngineContentRoot>
      <_SEGameContentRoot>$(_SEContentRoot)Game\</_SEGameContentRoot>
      <_SEContentManifest>$(_SEContentRoot).se-managed-files.txt</_SEContentManifest>
    </PropertyGroup>
    <ItemGroup>
      <_SEEngineContent Include="$(SERootDir)Engine\Content\**\*" />
      <_SEGameContent Include="$(SERootDir)Game\Content\**\*" />
      <!-- 배포할 폰트에는 외부 원본 폴더의 라이선스와 고지도 함께 둔다. -->
      <_SEFontNotices Include="$(SERootDir)Engine\ThirdParty\Fonts\NotoSansMono\OFL.txt;$(SERootDir)Engine\ThirdParty\Fonts\NotoSansMono\NOTICE.txt" />
      <_SEContentSource Include="@(_SEEngineContent);@(_SEGameContent);@(_SEFontNotices)" />
      <_SECurrentContent Include="@(_SEEngineContent-&gt;'Engine\%(RecursiveDir)%(Filename)%(Extension)');@(_SEGameContent-&gt;'Game\%(RecursiveDir)%(Filename)%(Extension)');@(_SEFontNotices-&gt;'Engine\Fonts\%(Filename)%(Extension)')" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_SECurrentContent)">
      <Output TaskParameter="Filtered" ItemName="_SEUniqueContent" />
    </RemoveDuplicates>
    <Error Condition="'@(_SECurrentContent-&gt;Count())' != '@(_SEUniqueContent-&gt;Count())'" Text="콘텐츠 출력 경로가 중복된다." />
    <ReadLinesFromFile File="$(_SEContentManifest)" Condition="Exists('$(_SEContentManifest)')">
      <Output TaskParameter="Lines" ItemName="_SEPreviousContent" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_SEPreviousContent>
        <ResolvedPath>$([System.IO.Path]::GetFullPath('$(_SEContentRoot)%(_SEPreviousContent.Identity)'))</ResolvedPath>
      </_SEPreviousContent>
      <_SEStaleContent Include="@(_SEPreviousContent)" Exclude="@(_SECurrentContent)" />
    </ItemGroup>
    <!-- 이전 목록도 정규화된 엔진/게임 출력 안에 있는지 확인한 뒤 파일만 삭제한다. -->
    <Error Condition="'@(_SEPreviousContent)' != '' And !$([System.String]::Copy('%(_SEPreviousContent.ResolvedPath)').StartsWith('$(_SEEngineContentRoot)', System.StringComparison.OrdinalIgnoreCase)) And !$([System.String]::Copy('%(_SEPreviousContent.ResolvedPath)').StartsWith('$(_SEGameContentRoot)', System.StringComparison.OrdinalIgnoreCase))" Text="관리 목록의 콘텐츠 경로가 출력 범위를 벗어난다: %(_SEPreviousContent.Identity)" />
    <MakeDir Directories="$(_SEContentRoot)" />
    <Copy SourceFiles="@(_SEContentSource)" DestinationFiles="@(_SECurrentContent-&gt;'$(_SEContentRoot)%(Identity)')" SkipUnchangedFiles="true" />
    <Delete Files="@(_SEStaleContent-&gt;'%(ResolvedPath)')" />
    <WriteLinesToFile File="$(_SEContentManifest)" Lines="@(_SECurrentContent)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <!-- 이전 개별 복사 Target이 만들었던 네 파일만 새 배치로 이전한 뒤 정리한다. -->
    <Delete Files="$(_SEContentRoot)Textures\Checker.png;$(_SEContentRoot)Fonts\DebugMono.spritefont;$(_SEContentRoot)Fonts\OFL.txt;$(_SEContentRoot)Fonts\NOTICE.txt" />
  </Target>
