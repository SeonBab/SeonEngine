<?xml version="1.0" encoding="utf-8"?>
<!-- 모든 .vcxproj에 자동으로 적용되는 공통 설정. 프로젝트별 설정(종류, include 경로, 링커)은 각 .vcxproj에 둔다. -->
<!-- VS 속성 페이지에서 바꾼 값은 이 파일이 아니라 .vcxproj에 저장된다. 공통 설정은 이 파일을 직접 고친다. -->
<Project>
  <PropertyGroup>
    <!-- 저장소 루트. 프로젝트에서 다른 폴더를 가리킬 때 쓴다. -->
    <SERootDir>$(MSBuildThisFileDirectory)</SERootDir>
    <OutDir>$(SERootDir)Binaries\$(Platform)\$(Configuration)\</OutDir>
    <!-- ProjectName은 이 파일이 import되는 시점에 아직 정의되지 않으므로 MSBuildProjectName을 쓴다. -->
    <IntDir>$(SERootDir)Intermediate\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <ExceptionHandling>false</ExceptionHandling>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>SE_PLATFORM_WINDOWS=1;_HAS_EXCEPTIONS=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalOptions>/utf-8 /w14668 /w14265 %(AdditionalOptions)</AdditionalOptions>
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>SE_BUILD_DEBUG=1;SE_BUILD_RELEASE=0;_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>SE_BUILD_DEBUG=0;SE_BUILD_RELEASE=1;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
