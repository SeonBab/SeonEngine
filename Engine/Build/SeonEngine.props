<?xml version="1.0" encoding="utf-8"?>
<!-- 엔진을 사용하는 C++ 프로젝트가 명시적으로 import하는 설정. -->
<Project>
  <PropertyGroup>
    <SEEngineRootDir>$(MSBuildThisFileDirectory)..\</SEEngineRootDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(SEEngineRootDir)Source\Core\Public;$(SEEngineRootDir)Source\Engine\Public;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- 정적 Engine.lib가 사용하는 시스템 라이브러리는 최종 실행 파일 / DLL 링크에서 제공한다. -->
  <ItemDefinitionGroup Condition="'$(ConfigurationType)' == 'Application' or '$(ConfigurationType)' == 'DynamicLibrary'">
    <Link>
      <AdditionalDependencies>d3d11.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
